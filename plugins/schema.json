{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.freeunit.org/schema.json",
  "title": "FreeUnit plugin catalog entry",
  "description": "One catalog recipe. Reach is scope+country; certificate entries also carry trust.",
  "type": "object",
  "required": ["id", "name", "category", "scope", "trust"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable, lowercase slug.",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["acme-client", "cert-hook", "tls-backend", "telemetry", "auth", "other"]
    },
    "scope": {
      "type": "string",
      "enum": ["worldwide", "country"],
      "description": "Reach: worldwide for any operator, country for a jurisdiction-specific integration."
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2, uppercase (ru -> RU). Required when scope is 'country'.",
      "pattern": "^[A-Z]{2}$"
    },
    "region": {
      "type": "string",
      "description": "Optional region code, lowercase (e.g. eu).",
      "pattern": "^[a-z]{2,3}$"
    },
    "trust": {
      "type": "string",
      "enum": ["in-browser-store", "self-installed"],
      "description": "For certificate entries: is the root publicly trusted, or must the operator install it? Country != trust."
    },
    "issuer": {
      "type": "string",
      "description": "Certificate issuer(s), for cert entries."
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other entry ids this one builds on."
    },
    "source": {
      "type": "string",
      "description": "Docs/hook location (path in this repo, or a URL)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scope": { "const": "country" } },
        "required": ["scope"]
      },
      "then": { "required": ["country"] },
      "else": { "not": { "required": ["country"] } }
    }
  ]
}
